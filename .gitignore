# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local configuration and editor files
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/

# Generated OECD data and reports (never commit raw or derived artifacts)
data/**
!data/**/.gitkeep
reports/**
!reports/**/.gitkeep
warehouse/**
!warehouse/**/.gitkeep
snapshots/**
!snapshots/**/.gitkeep

# Local tooling output
*.log
*.tmp
